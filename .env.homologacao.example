# Copie para .env.homologacao (ignorado pelo Git) e preencha com o SEI de homologação.
# Usado por: composer wsdl:baixar, composer test:integration e o teste de contrato.

# SEI: sistema e serviço cadastrados em Administração > Sistemas
SEI_TEST_WSDL=https://sei-hml.orgao.gov.br/sei/controlador_ws.php?servico=sei
SEI_TEST_SIGLA=
SEI_TEST_CHAVE=
SEI_TEST_UNIDADE=
SEI_TEST_VERIFY_SSL=1

# Dados para o teste que gera um processo real (deixe em branco para pular)
SEI_TEST_TIPO_PROCESSO=
SEI_TEST_SERIE_GERADO=
SEI_TEST_SERIE_EXTERNO=
# UTF-8 (padrão) ou ISO-8859-1: confira os acentos do documento gerado no editor do SEI
SEI_TEST_CHARSET=UTF-8

# SIP (opcional)
SIP_TEST_WSDL=https://sip-hml.orgao.gov.br/sip/controlador_ws.php?servico=sip
